APP_NAME=Koralink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use https when the site is served over TLS (required to avoid redirect loops behind nginx/Apache).
# Example production: APP_URL=https://skillshub.sandbox.rw
APP_URL=http://localhost

APP_INITIAL_LOCALE=rw
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: null. Production only: .sandbox.rw (must NOT use .sandbox.rw on localhost or you get 419 errors)
SESSION_DOMAIN=null
# Set true in production when using HTTPS (auto-true when APP_URL starts with https://)
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" only WRITES emails to storage/logs/laravel.log - nothing reaches a real inbox.
# For real delivery set MAIL_MAILER=smtp and fill in the SMTP details, then check it with:
#   php artisan config:clear && php artisan mail:test you@example.com
#
# Gmail example (needs 2-Step Verification + a Google "app password", NOT your normal password):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp            # smtp = STARTTLS on port 587 | smtps = SSL on port 465 ("tls" is NOT valid)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-gmail-address@gmail.com
#   MAIL_PASSWORD=your-16-character-app-password
#   MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"   # Gmail always sends as the logged-in account
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
